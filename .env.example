# Firebase web app config (public identifiers, but kept out of git). Get values with:
#   firebase apps:sdkconfig WEB 1:77078050782:web:42ae0b9225e7fe42078f4f --project recipe-lewis-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=recipe-lewis-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=recipe-lewis-app
VITE_FIREBASE_STORAGE_BUCKET=recipe-lewis-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=77078050782
VITE_FIREBASE_APP_ID=1:77078050782:web:42ae0b9225e7fe42078f4f
# Set to 1 to talk to the local emulators (npm run emulators) instead of production.
VITE_USE_EMULATOR=
