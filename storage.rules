rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isMember() { return signedIn() && (request.auth.token.get('member', false) == true || isAdmin()); }

    match /recipes/{recipeId}/images/{file} {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isMember();
    }
    match /recipes/{recipeId}/files/{file} {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isMember();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
